# Data and outputs live on the server, never in git
data/*
!data/.gitkeep
results/*
!results/.gitkeep
work/
logs/

# Nextflow
.nextflow/
.nextflow.log*

# Generated on the server by the scripts
scripts/*/samplesheets/*.csv
scripts/*/conf/oncoanalyser_refdata.config
# PBS job output (qsub -j oe)
scripts/*/*.o[0-9]*

# OS
.DS_Store
