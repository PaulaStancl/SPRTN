/*
 * Site config for the real-data WGS runs - LOCAL executor: every task runs on
 * the machine Nextflow runs on (lobsang interactively, or the node of a PBS job
 * started by qsub_*.sh). Passed to every run by nf_run (00_config.sh).
 *
 * Container settings only. The cpu/memory caps are NOT here: nf_run writes them
 * per launch to <run dir>/resources.config, so inside a PBS job they match the
 * job's allocation, and resourceLimits scales down any task that asks for more
 * (sarek bwa-mem2: 24 cpus; oncoanalyser 3.0.0's heavy steps: 12 cpus / 72 GB).
 * Pipeline parameters go on the command line in the 02-04 run scripts.
 */

process {
    executor = 'local'
}

// The FASTQ live on /common/RAW (the archive): bound READ-ONLY so no pipeline
// step can write into it. The run scripts check the mount before starting.
// Both blocks set, so -profile apptainer and -profile singularity both work.
apptainer {
    cacheDir    = System.getenv('NXF_APPTAINER_CACHEDIR')
    autoMounts  = true
    runOptions  = '-B /common/WORK -B /common/RAW:/common/RAW:ro'
    pullTimeout = '2h'
}
singularity {
    cacheDir    = System.getenv('NXF_SINGULARITY_CACHEDIR')
    autoMounts  = true
    runOptions  = '-B /common/WORK -B /common/RAW:/common/RAW:ro'
    pullTimeout = '2h'
}
