/*
 * Site config for nf-core WGS pipelines on lobsang - LOCAL executor.
 * Passed to every run by nf_run (00_config.sh) as:  -c conf/lobsang.config
 *
 * Only resources and container settings live here. Pipeline parameters go on
 * the command line in the 10-12 run scripts.
 *
 * CHECK the two numbers against 01_check_system.sh (nproc / RAM) before the
 * first run. The pipelines ask for more than this (sarek BWA-MEM2: 24 cpus,
 * oncoanalyser ESVEE: 32 cpus) - resourceLimits scales those requests down.
 */

process {
    executor = 'local'

    resourceLimits = [
        cpus  : 12,
        memory: 400.GB,
        time  : 240.h
    ]
}

executor {
    // Never schedule more than the machine has.
    cpus   = 12
    memory = 400.GB
}

// Both blocks set, so -profile apptainer and -profile singularity both work.
apptainer {
    cacheDir    = System.getenv('NXF_APPTAINER_CACHEDIR')
    autoMounts  = true
    runOptions  = '-B /common/WORK'
    pullTimeout = '2h'     // large images (GATK, hmftools) can take a while
}
singularity {
    cacheDir    = System.getenv('NXF_SINGULARITY_CACHEDIR')
    autoMounts  = true
    runOptions  = '-B /common/WORK'
    pullTimeout = '2h'
}
